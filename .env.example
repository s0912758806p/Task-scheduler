# Neon Postgres connection string (production and local dev alike). The app's driver
# (@neondatabase/serverless) connects over Neon's WebSocket endpoint, so a plain local Postgres does
# not work — use a Neon project or branch. `npm test` uses in-memory PGlite and needs no DATABASE_URL.
DATABASE_URL=
# Secret used by Better Auth to sign sessions; generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL of the app (e.g. http://localhost:3000 locally, your deployed URL in production)
BETTER_AUTH_URL=http://localhost:3000
# OAuth is optional: a provider is enabled only when both its client ID and secret are set
# GitHub OAuth app client ID
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret
GITHUB_CLIENT_SECRET=
# Google OAuth client ID
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# Set to 1 (never in production) to show the email/password form on the login page for Playwright
# E2E tests. Email/password sign-in itself is always enabled on the server.
E2E_AUTH=
