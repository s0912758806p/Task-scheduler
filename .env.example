# Postgres connection string (Neon in production; local Postgres or PGlite in dev/test)
DATABASE_URL=
# Secret used by Better Auth to sign sessions; generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL of the app (e.g. http://localhost:3000 locally, your deployed URL in production)
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app client ID
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret
GITHUB_CLIENT_SECRET=
# Google OAuth client ID
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
